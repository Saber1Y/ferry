diff --git a/src/commands/migration/broadcast.rs b/src/commands/migration/broadcast.rs
new file mode 100644
index 0000000..0158f88
--- /dev/null
+++ b/src/commands/migration/broadcast.rs
@@ -0,0 +1,125 @@
+//! `migration broadcast`: submit the migration transaction that is proved and due, through a
+//! lightwalletd server, and record the outcome in the migration state.
+//!
+//! Added for FERRY. `migration advance` stops at this step ("broadcasting isn't wired up in this
+//! command yet"); this command performs it with `PoolMigrations::take_transaction_for_broadcast`,
+//! then `MigrationState::mark_broadcast` on success or `report_broadcast_failure` on rejection.
+
+use anyhow::anyhow;
+use clap::Args;
+use rand::{rand_core::UnwrapErr, rngs::SysRng};
+use uuid::Uuid;
+
+use zcash_client_backend::{
+    data_api::{Account as _, WalletRead},
+    proto::service,
+};
+use zcash_client_sqlite::{WalletDb, util::SystemClock};
+use zcash_pool_migration::engine::{MigrationTxKind, PoolMigrationRead, PoolMigrationWrite};
+use zcash_pool_migration::satisfiability::{
+    AdvanceConfig, DuenessTargets, ReorgSettleDepth, advance_migration,
+};
+use zcash_pool_migration::state::AdvanceStep;
+
+use crate::{
+    commands::select_account, config::get_wallet_network, data::get_db_paths,
+    remote::ConnectionArgs,
+};
+
+use super::store::{migration_store, open_connection};
+
+/// Same settle margin `migration advance` uses.
+const REORG_SETTLE_DEPTH: ReorgSettleDepth = ReorgSettleDepth::new(10);
+
+/// Options accepted for the `migration broadcast` command.
+#[derive(Debug, Args)]
+pub(crate) struct Command {
+    /// The UUID of the account whose due migration transaction to broadcast
+    account_id: Option<Uuid>,
+
+    /// The lightwalletd server to broadcast through. Use a different server from the one the
+    /// wallet syncs from (ZIP 318: keep synchronization and broadcast unlinkable).
+    #[command(flatten)]
+    connection: ConnectionArgs,
+}
+
+impl Command {
+    pub(crate) async fn run(self, wallet_dir: Option<String>) -> anyhow::Result<()> {
+        let params = get_wallet_network(wallet_dir.as_ref())?;
+        let (_, db_path) = get_db_paths(wallet_dir.as_ref());
+        let mut conn = open_connection(&db_path)?;
+
+        let (account_id, scanned, tip) = {
+            let wallet_db =
+                WalletDb::from_connection(&mut conn, params, SystemClock, UnwrapErr(SysRng));
+            let account = select_account(&wallet_db, self.account_id)?;
+            let scanned = wallet_db
+                .block_fully_scanned()
+                .map_err(|e| anyhow!("wallet read failed: {e:?}"))?
+                .ok_or_else(|| anyhow!("wallet has not scanned any blocks yet"))?
+                .block_height();
+            let tip = wallet_db
+                .chain_height()
+                .map_err(|e| anyhow!("wallet read failed: {e:?}"))?
+                .ok_or_else(|| anyhow!("wallet is not synced"))?;
+            (account.id(), scanned, tip)
+        };
+        let targets = DuenessTargets::new(scanned + 1, tip + 1);
+        let config = AdvanceConfig::new(REORG_SETTLE_DEPTH);
+        let mut rng = UnwrapErr(SysRng);
+
+        let mut store = migration_store(params, &mut conn, account_id)?;
+        let Some(mut state) = store.get_migration()? else {
+            println!("No migration in progress.");
+            return Ok(());
+        };
+        let advance = advance_migration(&mut store, &mut state, targets, &config, &mut rng)?;
+        let AdvanceStep::Broadcast { id } = advance.step() else {
+            println!(
+                "Nothing is due to broadcast. Run `migration advance` to prove what is ready, or \
+                 `migration status` to see what is next."
+            );
+            return Ok(());
+        };
+        let id = *id;
+        // A scheduler needs to know whether this crosses the turnstile (a transfer) or not (a
+        // preparation): ZIP 318 spaces pool-crossing broadcasts with fresh random delays.
+        let kind = match state
+            .transactions()
+            .iter()
+            .find(|t| t.id() == id)
+            .map(|t| t.kind())
+        {
+            Some(MigrationTxKind::Transfer { .. }) => "transfer",
+            Some(MigrationTxKind::Preparation { .. }) => "preparation",
+            None => return Err(anyhow!("migration transaction {} not found", u32::from(id))),
+        };
+
+        let tx = store.take_transaction_for_broadcast(&mut rng, &state, id)?;
+        let txid = tx.txid();
+        let mut raw_tx = service::RawTransaction::default();
+        tx.write(&mut raw_tx.data)?;
+
+        let mut client = self.connection.connect(params, wallet_dir.as_ref()).await?;
+        let response = client.send_transaction(raw_tx).await?.into_inner();
+
+        if response.error_code == 0 {
+            state.mark_broadcast(id);
+            store.replace_migration(&state)?;
+            println!(
+                "Broadcast migration {kind} {} as {txid}",
+                u32::from(id)
+            );
+            Ok(())
+        } else {
+            state.report_broadcast_failure(id, tip);
+            store.replace_migration(&state)?;
+            Err(anyhow!(
+                "node rejected migration transaction {} ({txid}): code {}: {}",
+                u32::from(id),
+                response.error_code,
+                response.error_message
+            ))
+        }
+    }
+}
